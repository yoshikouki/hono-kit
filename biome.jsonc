{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/react",
    "ultracite/biome/vitest"
  ],
  "formatter": {
    "enabled": true
  },
  "json": {
    "formatter": {
      "enabled": true
    }
  },
  "assist": {
    "actions": {
      "source": {
        // Only class/className sorting (linter: useTailwindSortedClasses) is enabled.
        "organizeImports": "off",
        "useSortedAttributes": "off",
        "useSortedKeys": "off",
        "useSortedEnumMembers": "off",
        "useSortedInterfaceMembers": "off",
        "useSortedProperties": "off",
        "useSortedTypeFields": "off",
        "useSortedSelectionSet": "off",
        "useSortedPackageJson": "off",
        "useGraphqlSortedDefinitions": "off",
        "useGraphqlSortedVariables": "off",
        "useGraphqlSortedArguments": "off"
      }
    }
  },
  "linter": {
    "rules": {
      "complexity": {
        "noExcessiveCognitiveComplexity": "off"
      },
      "performance": {
        "noBarrelFile": "off"
      },
      "style": {
        "useConsistentArrayType": "off",
        "useConsistentTypeDefinitions": "off",
        "useConsistentArrowReturn": "off",
        "useConsistentObjectDefinitions": "off",
        "useConsistentMemberAccessibility": "off",
        "noShoutyConstants": "off",
        "useNumericSeparators": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["scripts/**/*.ts"],
      "javascript": {
        "globals": ["Bun"]
      }
    },
    {
      "includes": ["**/test/**/*.ts"],
      "linter": {
        "rules": {
          "performance": {
            "useTopLevelRegex": "off"
          }
        }
      }
    },
    {
      "includes": [
        "packages/hono-file-router/scripts/typecheck-readme.ts",
        "packages/hono-file-router/src/route-path.ts",
        "packages/hono-rsc-renderer/src/inject-rsc-payload.ts",
        "packages/hono-rsc-renderer/test/render-html.test.ts",
        "samples/rsc-vite-basic/test/built-handler.test.ts",
        "scripts/release-contract.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            // Preserve existing positional capture groups and their consumers.
            "useNamedCaptureGroup": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/hono-file-router/test/index.test.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            // Preserve existing conditional assertions in router tests.
            "noConditionalExpect": "off"
          }
        }
      }
    }
  ],
  "files": {
    "includes": [
      "!!**/worker-configuration.d.ts",
      "!!**/migrations/meta",
      "!!**/bun.lock",
      "!!**/dist",
      "!!**/.release"
    ]
  }
}

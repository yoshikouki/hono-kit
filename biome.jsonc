{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/react",
    "ultracite/biome/vitest"
  ],
  "formatter": {
    "enabled": true
  },
  "json": {
    "formatter": {
      "enabled": true
    }
  },
  "assist": {
    "actions": {
      "source": {
        // Only class/className sorting (linter: useTailwindSortedClasses) is enabled.
        "organizeImports": "off",
        "useSortedAttributes": "off",
        "useSortedKeys": "off",
        "useSortedEnumMembers": "off",
        "useSortedInterfaceMembers": "off",
        "useSortedProperties": "off",
        "useSortedTypeFields": "off",
        "useSortedSelectionSet": "off",
        "useSortedPackageJson": "off",
        "useGraphqlSortedDefinitions": "off",
        "useGraphqlSortedVariables": "off",
        "useGraphqlSortedArguments": "off"
      }
    }
  },
  "linter": {
    "rules": {
      "complexity": {
        "noExcessiveCognitiveComplexity": "off"
      },
      "performance": {
        "noBarrelFile": "off"
      },
      "style": {
        "useConsistentArrayType": "off",
        "useConsistentTypeDefinitions": "off",
        "useConsistentArrowReturn": "off",
        "useConsistentObjectDefinitions": "off",
        "useConsistentMemberAccessibility": "off",
        "noShoutyConstants": "off",
        "useNumericSeparators": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["scripts/**/*.ts"],
      "javascript": {
        "globals": ["Bun"]
      }
    },
    {
      "includes": ["**/test/**/*.ts"],
      "linter": {
        "rules": {
          "performance": {
            "useTopLevelRegex": "off"
          }
        }
      }
    },
    {
      // パッケージの変更はリリースになるため、次のリリースで適用する（yoshikouki/agent#78）
      "includes": ["packages/**"],
      "formatter": {
        "enabled": false
      },
      "json": {
        "formatter": {
          "enabled": false
        }
      },
      "linter": {
        "rules": {
          "style": {
            "useUnicodeRegex": "off",
            "useNamedCaptureGroup": "off"
          },
          "suspicious": {
            "noConditionalExpect": "off"
          }
        }
      }
    }
  ],
  "files": {
    "includes": [
      "!!**/worker-configuration.d.ts",
      "!!**/migrations/meta",
      "!!**/bun.lock",
      "!!**/dist",
      "!!**/.release"
    ]
  }
}
